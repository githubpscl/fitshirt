# Turso Database (https://turso.tech) - create a free account
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Admin Dashboard Password
ADMIN_PASSWORD=admin123

# Leave empty to use local SQLite file for development
# When both TURSO_DATABASE_URL is empty AND no production env, falls back to file:local.db
