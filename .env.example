# =========================================================================
# Datenbank — Turso (https://turso.tech). 500 Datenbanken, 9 GB gratis.
# Ohne diese Werte faellt der Server lokal auf eine SQLite-Datei `local.db`
# zurueck. Auf Vercel MUSS Turso gesetzt sein, weil das Dateisystem dort
# nur tmp ist und beim naechsten Cold-Start verloren geht.
# =========================================================================
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# =========================================================================
# Admin-Dashboard
# Aenderung dringend empfohlen, default ist "admin123" (im Code als Fallback).
# =========================================================================
ADMIN_PASSWORD=admin123

# =========================================================================
# Email-Versand — Resend (https://resend.com). 100 Mails/Tag, 3000/Monat gratis.
# Optional: wenn RESEND_API_KEY fehlt, geht keine Mail raus (Bestellung wird
# trotzdem normal angenommen und gespeichert).
# =========================================================================
RESEND_API_KEY=
# Absender. Ohne verifizierte Domain: "FitShirt <onboarding@resend.dev>"
RESEND_FROM=FitShirt <onboarding@resend.dev>
# Adresse, an die intern jede neue Bestellung gemeldet wird (= deine Mail).
ADMIN_EMAIL=

# =========================================================================
# Oeffentliche URL — wird in Mails und Bestaetigungslinks verwendet.
# =========================================================================
PUBLIC_URL=https://fitshirt-roan.vercel.app
